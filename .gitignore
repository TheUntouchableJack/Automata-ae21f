# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Claude
.claude/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Dependencies (if added later)
node_modules/

# Build output (if added later)
dist/
build/

# Temporary files
*.tmp
*.temp

# Local Netlify folder
.netlify

# Test artifacts
.playwright-mcp/
test-results/
playwright-report/

# Video project (Remotion).
# Local production asset, not part of the deployed site. Ignored wholesale
# because publish = "." serves every committed file publicly, and this tree
# holds reference stills and a third-party video transcript.
video/

# Large temporary images (testing/screenshots)
*.screenshot.png
*-test-*.png

# Development screenshots (not for production)
home-*.png
architect-*.png
24hd-*.png
sign-off-*.png
pdf-*.png

# Prerendered blog pages. Generated from newsletter_articles by
# scripts/prerender-blog.mjs on every Netlify build — committing them means a
# stale copy can outrank the real one after an article is edited.
/blog/*.html
!/blog/index.html
!/blog/post.html

# Local visual-QA page. Lives at the repo root so Vite can serve it with the
# real styles.css, but publish = "." means a committed root-level HTML file
# would be live at royaltyapp.ai/<name>. Keep it out of git.
preview-gallery.html
